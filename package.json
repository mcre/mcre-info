{
  "name": "mcre-info",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "run-p api:build api:watch dev:vite",
    "dev:vite": "vite",
    "prebuild": "npm run site:build",
    "build": "run-s type-check build-only",
    "build-only": "vite-ssg build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build --force",
    "test:unit": "vitest run",
    "pree2e": "npm run build",
    "e2e": "playwright test",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:build": "rm -rf ./tmp-apis && npx openapi2aspida -i=./openapi.yaml -o=./tmp-apis/ && rsync -a --delete ./tmp-apis/ ./src/apis/ && rm -rf ./tmp-apis",
    "api:watch": "chokidar ./openapi.yaml -c \"npm run api:build\"",
    "site:build": "tsx ./bin/updateSitemap.ts",
    "lambda:test": "python3 -m unittest discover backend/lambda/tests",
    "cdk": "cd backend/cdk && PATH=.venv/bin:$PATH cdk",
    "cdk:synth:prod": "CDK_ENV=prod npm run cdk -- synth --all",
    "cdk:diff:prod": "CDK_ENV=prod npm run cdk -- diff --all",
    "cdk:deploy:prod": "CDK_ENV=prod npm run cdk -- deploy --all"
  },
  "dependencies": {
    "@aspida/fetch": "^1.14.0",
    "@mdi/js": "7.4.47",
    "@unhead/vue": "^2.1.13",
    "aspida": "^1.14.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.33",
    "vue-router": "^5.0.6",
    "vuetify": "^4.0.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.10",
    "@vue/tsconfig": "^0.9.1",
    "aws-cdk": "^2.1120.0",
    "beasties": "^0.3.5",
    "chokidar-cli": "^3.0.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-vuetify": "^4.6.2",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^8.0.4",
    "openapi2aspida": "^0.24.0",
    "prettier": "^3.8.3",
    "sass-embedded": "^1.99.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^8.0.10",
    "vite-plugin-vuetify": "^2.1.3",
    "vite-ssg": "^28.3.0",
    "vitest": "^4.1.5",
    "vue-tsc": "^3.2.8"
  }
}
